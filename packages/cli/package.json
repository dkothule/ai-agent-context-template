{
  "name": "@dkothule/ai-context",
  "version": "1.2.2",
  "publishConfig": {
    "access": "public"
  },
  "description": "Shared memory for coding agents — Cursor, Claude Code, and Codex",
  "license": "MIT",
  "author": "dkothule",
  "homepage": "https://github.com/dkothule/ai-context#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dkothule/ai-context.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/dkothule/ai-context/issues"
  },
  "keywords": [
    "ai",
    "llm",
    "agent",
    "context",
    "cursor",
    "claude",
    "claude-code",
    "codex",
    "multi-agent",
    "harness",
    "agent-harness",
    "ai-harness",
    "harness-engineering",
    "context-engineering",
    "context-management",
    "agents.md",
    "claude.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ai-context": "dist/index.js"
  },
  "files": [
    "dist/",
    "src/templates/",
    "src/prompts/setup/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prepack": "node scripts/copy-readme.js",
    "prepublishOnly": "npm run typecheck && npm run build && npm test && node scripts/assert-version-sync.js"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "clipboardy": "^4.0.0",
    "commander": "^12.0.0",
    "picocolors": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
